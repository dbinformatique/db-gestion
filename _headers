# D&B Gestion — en-têtes de sécurité (Netlify, glisser-déposer du dossier)
# L'application contient du script et du style en ligne : « 'unsafe-inline' » est donc
# nécessaire ici. Le site public, lui, n'en a pas (il est sur un autre site Netlify).
# Dette technique : retirer les « onclick » en ligne pour pouvoir supprimer 'unsafe-inline'.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://*.googleapis.com https://www.gstatic.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
